#### R code network analysis of policy interaction network

library(igraph)

net1st<-read.csv("C:/Users/David/OneDrive - Danmarks Tekniske Universitet/MPA4Sustainability/WP4/networkstats/03.Q1firstordercit.edgelist.csv")
net1st.graph<-readRDS("C:/Users/David/OneDrive - Danmarks Tekniske Universitet/MPA4Sustainability/WP4/networkstats/03.Q1firstordercit.network.csv.rds")
net1st.meta<-read.csv("C:/Users/David/OneDrive - Danmarks Tekniske Universitet/MPA4Sustainability/WP4/networkstats/03.Q1firstordercit.verticesmetadata.csv")

graph1st<-graph_from_data_frame(net1st, directed = TRUE, vertices = net1st.meta)

### this is a directed unweighted network

### degree_in and degree_out
graph1st.degree.in<-degree(graph1st,mode="in")
graph1st.degree.out<-degree(graph1st,mode="out")


##betweenness
#graph1st.betweenness<-estimate_betweenness(graph1st,directed = TRUE,cutoff = -1)
graph1st.betweenness<-betweenness(graph1st,directed = TRUE,normalized=FALSE)


#module
## as we have multiple components in the network we first need to identify components
#first we look for weakly connected component, so that any edge between clusters of text is considered as connecting the clsuters

graph1st.comp.weak<-components(graph1st,mode="weak")

graph1st.df<-data.frame(name= V(graph1st)$name,degree.in=graph1st.degree.in,degree.out=graph1st.degree.out,betweenness=graph1st.betweenness,component=as.numeric(membership(graph1st.comp.weak)))


